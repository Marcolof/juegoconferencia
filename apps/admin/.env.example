# Copiar como .env.local y completar con los datos del proyecto de Supabase
# (Project Settings → API). Nunca subir .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave-publica-anon-o-publishable
# Clave de servicio: sólo la usa el servidor del panel. Nunca en el navegador
# ni en la app del juego.
SUPABASE_SERVICE_ROLE_KEY=clave-secreta-service-role
