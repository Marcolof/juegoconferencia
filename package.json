{
  "name": "juego-conferencia",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:juego": "npm run dev -w apps/juego",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build -w apps/juego && npm run build -w apps/admin",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.9"
  }
}
